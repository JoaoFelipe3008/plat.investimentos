# Todas as chaves abaixo são lidas SOMENTE no servidor (route handlers). Nunca use NEXT_PUBLIC_ para chaves privadas.

# Brapi (cotações B3). Sem token, apenas PETR4, VALE3, ITUB4 e MGLU3 respondem. https://brapi.dev
BRAPI_TOKEN=

# CoinGecko (opcional). Sem chave usa a API pública com limites menores. https://www.coingecko.com/en/api
COINGECKO_DEMO_API_KEY=

# Finnhub (opcional): ações internacionais e notícias globais/cripto. https://finnhub.io
FINNHUB_API_KEY=

# Supabase (opcional). Sem estas variáveis o app roda em "modo local" (dados no navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
